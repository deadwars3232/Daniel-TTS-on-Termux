#!/data/data/com.termux/files/usr/bin/bash

set -euo pipefail

ROOT="$HOME/daniel_voice"
RVC="$ROOT/rvc-source"

export PIPER_VOICE_PATH="$HOME/tts/models"
export ESPEAK_DATA_PATH="$PREFIX/share/espeak-ng-data"
export OPENBLAS_NUM_THREADS=1
export OMP_NUM_THREADS=1

if [ $# -lt 1 ] || [ -z "$1" ]; then
    echo 'Usage: daniel-tts "Your text" [output.wav]'
    exit 1
fi

TEXT="$1"
OUTPUT="${2:-$PWD/daniel_output.wav}"

# Resolve output path.
mkdir -p "$(dirname "$OUTPUT")"
OUTPUT="$(realpath -m "$OUTPUT")"

# Temporary working directory.
TMP="$(mktemp -d)"

cleanup() {
    rm -rf "$TMP"
}

trap cleanup EXIT

echo "=================================="
echo "       DANIEL UK TTS"
echo "=================================="
echo "Text: $TEXT"
echo "Output: $OUTPUT"
echo

echo "[1/3] Generating UK speech..."

piper \
    -m en_GB-alan-medium \
    -f "$TMP/base.raw" \
    -- "$TEXT"

echo "[2/3] Converting Piper audio..."

# This Termux Piper build writes raw float32 audio.
# Convert it into a standard 22,050 Hz WAV.
ffmpeg -hide_banner -loglevel error -y \
    -f f32le \
    -ar 22050 \
    -ac 1 \
    -i "$TMP/base.raw" \
    -af "volume=0.15,alimiter=limit=0.5" \
    -c:a pcm_s16le \
    "$TMP/base.wav"

echo "[3/3] Applying Daniel UK voice..."

cd "$RVC"

python -u convert_daniel.py \
    "$TMP/base.wav" \
    "$OUTPUT"

echo
echo "=================================="
echo "SUCCESS!"
echo "Saved: $OUTPUT"
echo "=================================="
